# Supabase (projeto próprio — não mais gerenciado pelo Lovable)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PROJECT_ID=SEU-PROJETO
SUPABASE_PUBLISHABLE_KEY=coloque-a-anon-key-aqui
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PROJECT_ID=SEU-PROJETO
VITE_SUPABASE_PUBLISHABLE_KEY=coloque-a-anon-key-aqui

# Server-side apenas (nunca prefixar com VITE_ / nunca expor ao client):
# usado por src/integrations/supabase/client.server.ts para operações admin (bypassa RLS).
SUPABASE_SERVICE_ROLE_KEY=

# Gateway de IA (assistente do dashboard + geração de evolução SOAP).
# Antes usava o gateway do Lovable; agora aponta para qualquer endpoint compatível
# com o formato "chat/completions" da OpenAI. Padrão sugerido: OpenRouter, que usa
# o mesmo nome de modelo do Lovable ("google/gemini-2.5-flash"), então normalmente
# só é preciso preencher a chave.
AI_GATEWAY_API_KEY=
# AI_GATEWAY_URL=https://openrouter.ai/api/v1/chat/completions
# AI_GATEWAY_MODEL=google/gemini-2.5-flash

# Preset de build do Nitro (opcional). Se não definido: "vercel" quando a env VERCEL
# estiver presente (a própria Vercel define isso), senão "cloudflare-module".
# Para rodar num servidor Node/VPS próprio, defina NITRO_PRESET=node-server.
# NITRO_PRESET=
